{
  "global": {
    "ctrl-space": "whistle.whistle"
  },
  "terminal": {
    "ctrl-[": "whistle.enter"
  },
  "mod:whistle": {
    "ctrl-space": "whistle.type",
    "ctrl-h": "whistle.left",
    "ctrl-j": "whistle.down",
    "ctrl-k": "whistle.up",
    "ctrl-l": "whistle.right"
  },
  "layout:tuuxic": {
    "ctrl-space": "whistle.whistle",
    "ctrl-shift-k": "mod.open:tuuxic-picker",
    "ctrl-shift-p": "mod.open:tuuxic-palette",
    "ctrl-,": "mod.open:tuuxic-settings",
    "ctrl-shift-m": "mod.open:tuuxic-mod-manager",
    "super-ctrl-shift-space": "mod.open:tuuxic-themes",
    "super-ctrl-t": "mod.open:tuuxic-themes",
    "super-k": "mod.open:tuuxic-keys",
    "alt-enter": "pane.split:right",
    "alt-shift-enter": "pane.split:down",
    "alt-1": "tab.select:1",
    "alt-2": "tab.select:2",
    "alt-3": "tab.select:3",
    "alt-4": "tab.select:4",
    "alt-5": "tab.select:5",
    "alt-6": "tab.select:6",
    "alt-7": "tab.select:7",
    "alt-8": "tab.select:8",
    "alt-9": "tab.select:9",
    "alt-left": "tab.prev",
    "alt-right": "tab.next",
    "ctrl-h": "tab.prev",
    "ctrl-l": "tab.next",
    "alt-up": "space.prev",
    "alt-down": "space.next",
    "ctrl-left": "pane.go:left",
    "ctrl-right": "pane.go:right",
    "ctrl-up": "pane.go:up",
    "ctrl-down": "pane.go:down",
    "super-return": "terminal.open",
    "super-w": "pane.close",
    "super-f": "pane.zoom",
    "super-c": "terminal.copy",
    "super-v": "terminal.paste",
    "super-alt-space": "mod.open:tuuxic-palette",
    "super-shift-space": "layout.toggle:topbar",
    "ctrl-alt-shift-t": "tuuxic-tabs.reopen"
  }
}
