{
  "id": "root",
  "type": "column",
  "traffic_lights": [
    12,
    8
  ],
  "theme": "tokyo-night",
  "font": "CaskaydiaMono Nerd Font",
  "ui_font": "JetBrains Mono",
  "preview": "layouts/tuuxic.svg",
  "background": "canvas",
  "terminal_padding": [
    12,
    12
  ],
  "resizable": false,
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "hidden": true,
      "size": {
        "px": 30
      },
      "window_drag": true,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "bar-left",
          "type": "block",
          "content": {
            "mod": "tuuxic-bar",
            "props": {
              "part": "left"
            }
          },
          "size": {
            "weight": 3
          }
        },
        {
          "id": "ai-usage",
          "type": "block",
          "size": {
            "weight": 2.5
          },
          "content": {
            "mod": "tuuxic-ai-usage",
            "props": {
              "compact": true
            }
          }
        },
        {
          "id": "bar-right",
          "type": "block",
          "size": {
            "px": 100
          },
          "content": {
            "mod": "tuuxic-bar",
            "props": {
              "part": "right"
            }
          }
        }
      ]
    },
    {
      "id": "desk",
      "type": "row",
      "padding": 6,
      "gap": 6,
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 243
          },
          "min": 44,
          "max": 480,
          "resizable": false,
          "children": [
            {
              "id": "brand",
              "type": "block",
              "size": {
                "px": 36
              },
              "window_drag": true,
              "content": {
                "mod": "tuuxic-chrome"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "tuuxic-spaces"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "tuuxic-agents"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 106
              },
              "content": {
                "mod": "tuuxic-chrome",
                "props": {
                  "footer": true
                }
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            }
          ],
          "gap": 6
        },
        {
          "id": "work",
          "type": "column",
          "gap": 6,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 36
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "content": {
                "mod": "tuuxic-tabs"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "gap": 6,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "tuuxic-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "border"
                      },
                      "radius": 0,
                      "gap": 6,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "tuuxic-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "stack",
                          "active": "changes-view",
                          "children": [
                            {
                              "id": "changes-view",
                              "type": "block",
                              "content": {
                                "mod": "tuuxic-changes",
                                "props": {
                                  "graph": "git-graph"
                                }
                              }
                            },
                            {
                              "id": "git-graph",
                              "type": "block",
                              "content": {
                                "mod": "tuuxic-changes",
                                "props": {
                                  "view": "graph",
                                  "back": "changes-view"
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "browser-notes",
                          "type": "block",
                          "content": {
                            "mod": "tuuxic-notes"
                          }
                        }
                      ],
                      "active": "changes"
                    }
                  ],
                  "size": {
                    "px": 475
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  }
                }
              ]
            },
            {
              "id": "statusbar-work",
              "type": "block",
              "size": {
                "px": 26
              },
              "resizable": false,
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "content": {
                "mod": "whistle",
                "props": {
                  "bar": "Under the terminals",
                  "hintsLift": 13
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "statusbar",
      "type": "block",
      "hidden": true,
      "size": {
        "px": 22
      },
      "resizable": false,
      "background": "chrome",
      "content": {
        "mod": "whistle",
        "props": {
          "bar": "Full width",
          "enabled": false,
          "mappings": {
            "/": [
              "Go to tab or space",
              "mod.open:tuuxic-picker"
            ],
            "s": [
              "Select Spaces",
              "whistle.field:spaces"
            ],
            "a": [
              "Select Agents",
              "whistle.field:agents"
            ],
            "e": [
              "Files panel",
              "whistle.focus:files"
            ],
            "E": [
              "Toggle files panel",
              "whistle.toggle:files"
            ],
            "g": [
              "Changes panel",
              "whistle.focus:changes"
            ],
            "G": [
              "Toggle changes panel",
              "whistle.toggle:changes"
            ],
            "space": {
              "name": "Leader",
              "map": {
                "p": [
                  "Command palette",
                  "mod.open:tuuxic-palette"
                ],
                ",": [
                  "Settings",
                  "mod.open:tuuxic-settings"
                ],
                "?": [
                  "Keybindings",
                  "mod.open:tuuxic-keys"
                ],
                "m": [
                  "Mods",
                  "mod.open:tuuxic-mod-manager"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
